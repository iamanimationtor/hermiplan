# HERMIPLAN — environment variables
# Copy to .env for local development. For Netlify, set these in
# Site configuration → Environment variables (never commit real values).

# ─── Database (REQUIRED in production) ───────────────────────────────────────
# PostgreSQL connection string. Local default matches the sandbox database.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Force TLS. Set to "require" for hosted providers that reject plaintext
# connections (Neon, Supabase, RDS). Also enabled automatically when the
# connection string contains sslmode=require or ssl=true.
# DATABASE_SSL=require

# Maximum connections per serverless instance. Each Netlify function instance
# is a separate process with its own pool, so this multiplies across concurrent
# invocations. Use a pooled connection string for serverless workloads.
# DATABASE_POOL_MAX=3

# ─── Authentication (optional) ────────────────────────────────────────────────
# When set, OTP codes are delivered by your SMS provider and are NEVER included
# in API responses. Without a provider, phone login answers 503 and nothing is
# written to the database (guest usage is unaffected).
# SMS_PROVIDER_KEY=
# SMS_PROVIDER=kavenegar            # kavenegar (default) | http
# SMS_OTP_TEMPLATE=                 # required for kavenegar (verify lookup template)
# SMS_PROVIDER_URL=                 # required for provider=http
# SMS_PROVIDER_SENDER=

# Explicit opt-in for demo OTP (returns the code in the API response so login
# can be tested without an SMS provider). Leave unset in any public deployment.
# HERMIPLAN_ALLOW_DEMO_OTP=1

# ─── Rate limits (optional) ───────────────────────────────────────────────────
# Quotas are stored in PostgreSQL ("rate_limits") and are global across
# instances. Values are requests per documented window (see README).
# RATE_LIMIT_ANALYZE=60
# RATE_LIMIT_EXPORT=30
# RATE_LIMIT_PROJECTS=30
# RATE_LIMIT_PROJECT_READ=120
# RATE_LIMIT_AUTH=12
# RATE_LIMIT_OTP_REQUEST=5
# RATE_LIMIT_OTP_VERIFY=10
# RATE_LIMIT_SHARE_CREATE=10        # share-link creation, per hour
# RATE_LIMIT_SHARE_REVOKE=30        # revocation, per minute
# RATE_LIMIT_SHARE_READ=240          # shared report page views, per minute

# ─── Public origin of share links (recommended) ───────────────────────────────
# The canonical origin used when the server builds a /s/<token> link. Without it
# the request's own Host / x-forwarded-host is used, which can be an internal
# address behind a proxy or on a serverless platform.
# NEXT_PUBLIC_SITE_URL=https://hermiplan.netlify.app

# ─── Local real-PostgreSQL dev server (development only) ─────────────────────
# `npm run db:dev-server` starts a real PostgreSQL binary from the
# `embedded-postgres` devDependency. Not used by the application at runtime.
# PGPORT=5544
# PGDATA_DIR=/tmp/hermiplan-real-pg

# ─── Market data (optional) ──────────────────────────────────────────────────
# Optional JSON feed for live Iranian market rates. When unset, the dated
# reference catalogue is used and the UI says so explicitly.
# HERMIPLAN_MARKET_FEED=https://example.com/rates.json
# HERMIPLAN_MARKET_FEED_KEY=
