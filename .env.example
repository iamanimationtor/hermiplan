# HERMIPLAN — environment variables
# Copy to .env for local development. For Netlify, set these in
# Site configuration → Environment variables (never commit real values).

# ─── Database (REQUIRED in production) ───────────────────────────────────────
# PostgreSQL connection string. Local default matches the sandbox database.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Force TLS. Set to "require" for hosted providers that reject plaintext
# connections (Neon, Supabase, RDS). Also enabled automatically when the
# connection string contains sslmode=require or ssl=true.
# DATABASE_SSL=require

# TLS certificate verification is ON by default (the server certificate is
# authenticated). Set to "1" ONLY if your provider uses a private CA that
# cannot be verified from the serverless function runtime.
# DATABASE_SSL_SKIP_VERIFY=1

# ─── Site URL (SEO / OpenGraph / sitemap) ────────────────────────────────────
# Canonical origin used for OpenGraph images, canonical URLs, robots.txt and
# the sitemap. Set it to the production origin (custom domain or
# https://<site>.netlify.app). Without it, social previews fall back to a
# placeholder origin.
# NEXT_PUBLIC_SITE_URL=https://hermiplan.netlify.app

# Maximum connections per serverless instance. Each Netlify function instance
# is a separate process with its own pool, so this multiplies across concurrent
# invocations. Use a pooled connection string for serverless workloads.
# DATABASE_POOL_MAX=3

# ─── Authentication (optional) ────────────────────────────────────────────────
# When set, OTP codes are delivered by your SMS provider and are NEVER included
# in API responses.
# SMS_PROVIDER_KEY=

# Explicit opt-in for demo OTP (returns the code in the API response so login
# can be tested without an SMS provider). Leave unset in any public deployment.
# HERMIPLAN_ALLOW_DEMO_OTP=1

# ─── Market data (optional) ──────────────────────────────────────────────────
# Optional JSON feed for live Iranian market rates. When unset, the dated
# reference catalogue is used and the UI says so explicitly.
# HERMIPLAN_MARKET_FEED=https://example.com/rates.json
# HERMIPLAN_MARKET_FEED_KEY=
